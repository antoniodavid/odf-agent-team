  "cards": [
    {
      "dot": "emerald",
      "title": "Why one call wins",
      "items": [
        "Registry, agent, skills, and profile resolve inside odf_delegate — zero extra orchestrator turns",
        "Policy Gate and evidence seal run before the specialist starts, not after it guesses",
        "Specialist arrives with ≤5 compact rules instead of spending turns grepping the repo"
      ]
    },
    {
      "dot": "rose",
      "title": "Cost of the naive path",
      "items": [
        "Every grep + read is a model round-trip that bloats context",
        "Missed symbols trigger re-search loops with no single source of truth",
        "No gate runs between discovery and edit — errors surface late"
      ]
    },
    {
      "dot": "cyan",
      "title": "Measured shape",
      "items": [
        "ODF: 1 tool call → pre-loaded specialist → evidence-backed result",
        "Naive: O(N) search rounds → bloated context → same worktree outcome",
        "Optional CodeGraph collapses structural queries further (install with --with-codegraph)"
      ]
    }
