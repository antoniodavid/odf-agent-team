+    if (opts.phaseResultStatus !== "ok" && opts.phaseResultStatus !== "warning") {
+      return makeResult(
+        "blocked",
+        "workflow-result-invalid",
+        "The actual phase result must have status ok or warning before workflow state can advance.",
+        read.snapshot,
+        inspection.completed,
+        opts.validation,
+        null,
+      )
+    }
