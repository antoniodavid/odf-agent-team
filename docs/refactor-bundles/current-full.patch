+  if (opts.expectedStage !== "BUILD" && opts.expectedStage !== "VERIFY") {
+    return makeResult(
+      "blocked",
+      "workflow-stage-unsupported",
+      "Workflow commits may only target BUILD or VERIFY.",
+      null,
+      [],
+      opts.validation,
+      null,
+    )
+  }
