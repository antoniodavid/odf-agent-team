+    const failure = healthFileFailure(healthErrorCode(error))
+    return {
+      registry: emptyRegistryHealth(registryPath, failure.status),
+      warnings: [`registry-${failure.status}: ${registryPath}`],
+      permissionDenied: failure.permissionDenied,
+    }
+  }
