  "cards": [
    {
      "dot": "cyan",
      "title": "Orchestration",
      "items": [
        "odoo_orchestrator never writes code — it routes every phase through odf_delegate",
        "The plugin resolves the agent and injects at most five skill rules per delegation",
        "FIX and small-change run in supervised auto with one bounded retry"
      ]
    },
    {
      "dot": "emerald",
      "title": "Workflow & evidence",
      "items": [
        "Canonical DECIDE → PLAN → BUILD → VERIFY with legacy phase adapters",
        "Policy Gate, attempt ledger, and receipts are mandatory and run silently",
        "Assessment, design, and verify reports gate progression"
      ]
    },
    {
      "dot": "violet",
      "title": "Memory & context",
      "items": [
        "odf-registry.json is the pack's single source of truth",
        "OpenSpec artifacts live in the worktree; Engram carries cross-session memory",
        "Pre-tool safety and DB guardrails run on every delegation"
      ]
    }
  ]
